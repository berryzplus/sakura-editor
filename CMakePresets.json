{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24
  },
  "configurePresets": [
    {
      "name": "common",
      "displayName": "Default Config",
      "hidden": true,
      "toolchainFile": "${sourceDir}/tools/vcpkg/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "vs-common",
      "displayName": "Visual Studio generator Build",
      "inherits": "common",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/$env{BUILD_PLATFORM}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/$env{BUILD_PLATFORM}/vcpkg_installed",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/$env{BUILD_PLATFORM}",
        "VCPKG_HOST_TRIPLET": "$env{HOST_TRIPLET}",
        "VCPKG_TARGET_TRIPLET": "$env{TARGET_TRIPLET}"
      }
    },
    {
      "name": "msys2-common",
      "displayName": "Msys2 Build",
      "inherits": "msys2",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
        "CMAKE_RC_COMPILER": "C:/msys64/mingw64/bin/windres.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/mingw64/bin/ninja.exe",
        "ICONV_PATH": "C:/msys64/usr/bin/iconv.exe"
      },
      "environment": {
        "MSYSTEM": "MINGW64",
        "PATH": "C:/msys64/mingw64/bin${pathListSep}/usr/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "CMakeTools",
      "displayName": "CMakeTools Build",
      "inherits": "vs-common",
      "binaryDir": "${sourceDir}/build/$env{BUILD_PLATFORM}/CMakeTools"
    },
    {
      "name": "msys2",
      "displayName": "Msys2 Build",
      "inherits": "common",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "$env{BUILD_CONFIGURATION}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/${presetName}/vcpkg_installed",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}/output",
        "VCPKG_HOST_TRIPLET": "x64-mingw-dynamic",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static"
      }
    },
    {
      "name": "msys2-debug",
      "displayName": "Msys2 Debug Build",
      "inherits": "msys2-common",
      "environment": {
        "BUILD_CONFIGURATION": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "CMakeTools",
      "configurePreset": "CMakeTools",
      "configuration": "$env{BUILD_CONFIGURATION}"
    },
    {
      "name": "msys2",
      "configurePreset": "msys2"
    },
    {
      "name": "msys2-debug",
      "configurePreset": "msys2-debug"
    }
  ],
  "testPresets": [
    {
      "name": "msys2",
      "configurePreset": "msys2",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msys2-debug",
      "configurePreset": "msys2-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
